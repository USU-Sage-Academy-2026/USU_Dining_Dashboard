# Copy this file to .env in the repository root and add your provider's SMTP settings.
# Leave EMAIL_HOST empty to print password reset emails in the server terminal.
# Set these values to the SMTP credentials for your email provider to deliver email.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=
